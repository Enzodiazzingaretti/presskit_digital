{
  "name": "kexxy-sigil-gl",
  "private": true,
  "description": "Construye los bundles WebGL (sigilo de cromo y rider 3D) en assets/js; three.js queda en un chunk compartido",
  "scripts": {
    "build": "esbuild sigil-gl=sigil-gl.src.js rider3d=rider3d.src.js --bundle --splitting --format=esm --minify --target=es2019 --legal-comments=none --outdir=../../assets/js --chunk-names=gl/[name]-[hash]"
  },
  "devDependencies": {
    "esbuild": "0.24.0",
    "three": "0.160.0"
  }
}
